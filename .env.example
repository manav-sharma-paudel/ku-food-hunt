# Environment for docker-compose (repo root). Copy to `.env` — which is
# gitignored — and fill in the required values:
#
#   cp .env.example .env
#
# This file is only read by docker compose. Running the app outside Docker still
# uses apps/api/.env (see apps/api/.env.example).

# ───────────────────────────────── required

# Postgres superuser password for the `db` service.
POSTGRES_PASSWORD=

# Salts the one-way IP/User-Agent hashes attached to reviews and helpful votes.
# The API refuses to boot in production if this is left at the dev default, and
# a guessable value lets anyone brute-force the "anonymous" hashes back to real
# IP addresses. Generate one with:  openssl rand -hex 32
REVIEW_HASH_SALT=

# ───────────────────────────────── optional

POSTGRES_DB=ku_food_hunt
POSTGRES_USER=kfh

# Host port for the site. http://localhost:<WEB_PORT>
WEB_PORT=8080

# Public origin. Used for canonical/Open Graph URLs, the sitemap, and the links
# in partner emails. Must be an absolute URL. Note that SITE_URL is also baked
# into the web bundle at build time — change it and rebuild:
#   docker compose build web
SITE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Overrides the compose-assembled connection string. Point this at a managed
# database to run the API against something other than the bundled `db` service.
# DATABASE_URL=postgresql://user:password@host:5432/ku_food_hunt

# Cloudflare Turnstile secret.
#
# WARNING — leave this empty for now. The web client does not render a Turnstile
# widget and never sends a token, while verifyTurnstile() returns false whenever a
# secret is configured and the token is absent. Setting this makes the server
# reject every genuine review and partner submission with 403 TURNSTILE_FAILED.
# TURNSTILE_SECRET=

# Transactional email for the partner approve/reject flow. With no API key the
# messages — including the owner's edit-and-resubmit link — are written to the
# API log instead of sent, so owners never hear back.
# RESEND_API_KEY=
# MAIL_FROM=KU Food Hunt <no-reply@kufoodhunt.app>

# Public origin of the partner form when it lives on its own subdomain.
# Defaults to SITE_URL.
# PARTNERS_URL=https://partners.kufoodhunt.app

# Privacy-first analytics (cookieless, respects Do Not Track). Build-time only.
# VITE_ANALYTICS_DOMAIN=kufoodhunt.app
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
