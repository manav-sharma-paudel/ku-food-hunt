{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @ku-food-hunt/web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://ku-food-hunt-api-production.up.railway.app/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://ku-food-hunt-api-production.up.railway.app/uploads/$1" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
