# Public origin, used for canonical + Open Graph URLs in per-route <Seo>.
# Falls back to the current browser origin when unset (fine for local dev).
# VITE_SITE_URL=https://kufoodhunt.app

# Privacy-first analytics (Plausible-style, cookieless, DNT-respected). Off unless
# set. VITE_ANALYTICS_SRC overrides the script URL (e.g. a self-hosted instance).
# VITE_ANALYTICS_DOMAIN=kufoodhunt.app
# VITE_ANALYTICS_SRC=https://plausible.io/js/script.js
