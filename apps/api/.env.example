# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API. req.ip is resolved by walking
# back this many hops through X-Forwarded-For, and every rate limit plus the
# salted IP hash on reviews depends on it being right.
#   0  direct exposure — X-Forwarded-For ignored (default; correct for `pnpm dev`)
#   1  one proxy, e.g. the nginx container in docker-compose.yml
#   2  CDN in front of a platform router, e.g. Cloudflare → Railway
# Too low and every visitor shares one rate-limit bucket; too high and any client
# can forge X-Forwarded-For to bypass the limits entirely.
TRUST_PROXY=0

# Public origin used for absolute URLs in /sitemap.xml. Set to the real domain in prod.
SITE_URL=http://localhost:5173

# Database — local: postgresql://<mac-username>@localhost:5432/ku_food_hunt
DATABASE_URL=postgresql://user:password@localhost:5432/ku_food_hunt

# Anti-abuse — salts the one-way IP/User-Agent hashes on reviews and votes.
# Use a long random string in production; raw IPs are never stored.
REVIEW_HASH_SALT=kfh-dev-salt-change-me

# Cloudflare Turnstile secret. Leave unset in dev to skip the human check.
# In PRODUCTION the API refuses to start unless you either set this (and wire the
# client site key) OR explicitly opt out with TURNSTILE_DISABLED=true — bot
# protection must never be silently off.
# TURNSTILE_SECRET=
# TURNSTILE_DISABLED=false

# How many proxies/CDNs sit in front of the API. MUST be set in production when
# behind a proxy (e.g. 1 for nginx/Railway edge, 2 for Vercel→Railway); leaving
# it 0 behind a proxy collapses all rate limits into one shared bucket.
# TRUST_PROXY=0

# Admin provisioning for `pnpm db:seed`. BOTH must be set or no admin is created;
# there is no default account and no fallback password. Auth uses scrypt +
# httpOnly session cookies + CSRF (ADR 0005). Prefer provisioning out-of-band.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=

# Transactional email (partner onboarding notifications) via Resend.
# Leave unset in dev — emails are logged to the API console instead of sent.
# MAIL_FROM must be a sender on a domain you verified in Resend.
# RESEND_API_KEY=
# MAIL_FROM=KU Food Hunt <no-reply@kufoodhunt.app>

# Public origin of the partner onboarding form, used in emailed edit links.
# Defaults to SITE_URL; set this when the form lives on its own subdomain.
# PARTNERS_URL=https://partners.kufoodhunt.app
